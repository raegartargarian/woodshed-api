# Required
# Public — ships in the frontend bundle. Not a secret.
WS_APP_KEY=
WS_ROOT_TEMPLATE_ID=
WS_CLAIM_TEMPLATE_ID=
WS_SESSION_TEMPLATE_ID=
OPENAI_API_KEY=

# Auth: "apikey" for unattended work, "jwt" to relay the caller's token
FILEDGR_AUTH_MODE=jwt
FILEDGR_API_KEY=
FILEDGR_API_SECRET=

# Optional
WS_STAGE=dev
WS_PUBLIC_BASE_URL=http://localhost:8000
WS_ALLOWED_ORIGINS=http://localhost:5173
RESEND_API_KEY=
WS_EMAIL_FROM=
WS_EMAIL_REPLY_TO=
